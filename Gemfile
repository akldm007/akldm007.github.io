source "https://rubygems.org"

# Matches the GitHub Pages build environment (kramdown, rouge, jekyll-paginate,
# jekyll-feed, jekyll-sitemap, jekyll-gist, jemoji, etc. at GitHub's versions).
gem "github-pages", group: :jekyll_plugins

# Required by the Minimal Mistakes remote theme.
gem "jekyll-include-cache"
gem "jekyll-remote-theme"

# Ruby 3+ no longer ships webrick, which `jekyll serve` needs.
gem "webrick"
